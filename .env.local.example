# Browser-safe Supabase keys only
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Free Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
# No Firebase / OneSignal / paid push vendor required.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
# Contact used in VAPID JWT (mailto: is fine)
VAPID_SUBJECT=mailto:admin@yourcompany.com
